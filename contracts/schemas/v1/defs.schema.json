{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaya.invalid/contracts/v1/defs.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "uuid": {
      "description": "Lowercase hyphenated UUID; the pattern pins the syntax so every validator agrees",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "title": "Timestamp",
      "description": "RFC 3339 time in UTC with an uppercase T and Z, e.g. 2026-11-22T09:30:00Z or 2026-11-22T09:30:00.123Z",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "jid": {
      "description": "Any WhatsApp JID without a device part, as observed from whatsmeow: people (s.whatsapp.net, lid, hosted, hosted.lid), bots, groups, broadcast lists and channels",
      "type": "string",
      "pattern": "^[0-9A-Za-z._-]+@(s\\.whatsapp\\.net|lid|hosted|hosted\\.lid|bot|g\\.us|broadcast|newsletter)$",
      "maxLength": 128
    },
    "sendTarget": {
      "description": "A chat Kaya may send to: a person (phone-number or LID JID) or a group. Status, broadcast lists, channels and bots are not allowed.",
      "type": "string",
      "pattern": "^([0-9]+@(s\\.whatsapp\\.net|lid)|[0-9]+(-[0-9]+)?@g\\.us)$",
      "maxLength": 128
    },
    "id": {
      "description": "A database row id",
      "type": "integer",
      "minimum": 1
    },
    "waId": {
      "description": "WhatsApp message id",
      "type": "string",
      "pattern": "^[0-9A-Za-z._-]{1,128}$"
    },
    "messageKind": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio",
        "voice",
        "document",
        "sticker",
        "location",
        "contact",
        "poll",
        "other"
      ]
    },
    "error": {
      "title": "ErrorDetail",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
